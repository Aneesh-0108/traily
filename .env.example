# Copy to `.env` for local development (optional).
# All values are local paths/settings. No network configuration exists:
# runtime inference is offline and CPU-only.

# Question data (Phase 1 fictional fixture; Phase 2: offline OSM pack)
TRAILY_PLACES_FILE=data/places.json
TRAILY_PACK_FILE=data/packs/area.json
# Manual TEST coordinates (labelled manual, never live location)
TRAILY_LAT=
TRAILY_LON=
# Location source for --pack mode: manual (test coords) or gpsd (localhost daemon)
TRAILY_LOCATION_SOURCE=manual
TRAILY_MAX_LOCATION_AGE_S=30
# Fixed demo language (English only per AGENTS.md)
TRAILY_LANGUAGE=en

# Local model files (verified present; never downloaded at runtime)
TRAILY_WHISPER_MODEL=models/whisper/ggml-base.en.bin
TRAILY_LLM_MODEL=models/llm/Qwen3.5-4B-Q4_K_M.gguf
TRAILY_PIPER_VOICE=models/piper/en_US-lessac-medium.onnx

# Local executables (whisper/llama = system tools; piper = project .venv)
TRAILY_WHISPER_BIN=whisper-cli
TRAILY_LLAMA_BIN=llama-cli
TRAILY_PIPER_BIN=.venv/bin/piper
TRAILY_ARECORD_BIN=parec
TRAILY_APLAY_BIN=paplay

# Pipeline settings
TRAILY_RECORD_SECONDS=8
TRAILY_RECORD_RATE_HZ=16000
TRAILY_MAX_PLACES=10
# LLM inference settings (defaults = known-good laptop measurement ~4.13 s)
TRAILY_LLM_CTX_SIZE=2048
TRAILY_LLM_BATCH_SIZE=128
TRAILY_LLM_UBATCH_SIZE=64
TRAILY_LLM_MAX_TOKENS=96
