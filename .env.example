# Copy to `.env` for local development (optional in Phase 0).
# All paths are local. No network configuration is needed:
# runtime inference is offline and CPU-only.

# Directory containing places.json fixture (Phase 1 will use real OSM data)
TRAILY_DATA_DIR=data
# Directory containing local model files (whisper / llm / piper)
TRAILY_MODELS_DIR=models
# Fixed demo language (English only per AGENTS.md)
TRAILY_LANGUAGE=en
